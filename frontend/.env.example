# Copy this file to `.env.local` and adjust:
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_, and they are baked into
# the JavaScript bundle at build time, so anyone can read them. Never put
# secrets here.

# Backend origin, without /api and without a trailing slash.
VITE_API_URL=http://localhost:5000
