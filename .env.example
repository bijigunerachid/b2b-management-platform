# Settings for `docker compose` (docker-compose.yml).
#   cp .env.example .env
# Never commit `.env`.
#
# Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app

# 32+ random characters.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Public address users open in the browser (scheme + host + port).
# Must match exactly: it is the only origin allowed to make changes.
PUBLIC_URL=http://localhost:8080

# Host port nginx listens on.
HTTP_PORT=8080

# Production only (docker-compose.prod.yml): your domain, e.g. demo.example.com.
# PUBLIC_URL above must then be https://<DOMAIN>.
# DOMAIN=

# ---------------------------------------------------------------
# Help assistant (optional)
# ---------------------------------------------------------------
# Without a key the helper answers from its built-in help guide.
# With an Anthropic API key, Claude writes the answers from the
# same guide. Each question costs a little; the daily limit caps
# how many questions per day can use Claude (the rest use search).
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_DAILY_LIMIT=300

# ---------------------------------------------------------------
# Public live demo (optional, never on real data)
# ---------------------------------------------------------------
# Shows one-click demo accounts on the login page and turns off
# password and account changes. DEMO_PASSWORD is shown publicly.
# Reset the data nightly with deploy/demo-reset.sh (docs/live-demo.md).
# DEMO_MODE=true
# DEMO_PASSWORD=
# DEMO_RESET_TIME=03:00 UTC
