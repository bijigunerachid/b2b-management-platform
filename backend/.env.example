# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# Never commit `.env`. It holds real credentials.

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=5000

# "production" enables Secure cookies and stricter startup checks.
NODE_ENV=development

# Frontend origin(s) allowed to call the API with cookies.
# Comma-separated. In production these must be https:// URLs.
CORS_ORIGIN=http://localhost:5173

# Set when running behind a reverse proxy (nginx, a load balancer,
# a PaaS router) so rate limiting sees real client IPs. Usually 1.
# TRUST_PROXY=1

# ---------------------------------------------------------------
# Database (MySQL 8)
# ---------------------------------------------------------------
DB_HOST=localhost
# DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=b2b_management

# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# ---------------------------------------------------------------
# One-time admin bootstrap (npm run create-admin)
# ---------------------------------------------------------------
# Uncomment only while creating the first admin, then remove both
# lines again. The password must be at least 12 characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# ---------------------------------------------------------------
# Demo data (npm run seed:large)
# ---------------------------------------------------------------
# Shared password for seeded @seed.b2b.local accounts. If unset, a
# random one is generated and printed once.
# SEED_USER_PASSWORD=
