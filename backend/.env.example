# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# Never commit `.env`. It holds real credentials.

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=5000

# "production" enables Secure cookies and stricter startup checks.
NODE_ENV=development

# Frontend origin(s) allowed to call the API with cookies.
# Comma-separated. In production these must be https:// URLs.
CORS_ORIGIN=http://localhost:5173

# Set when running behind a reverse proxy (nginx, a load balancer,
# a PaaS router) so rate limiting sees real client IPs. Usually 1.
# TRUST_PROXY=1

# ---------------------------------------------------------------
# Database (MySQL 8)
# ---------------------------------------------------------------
DB_HOST=localhost
# DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=b2b_management

# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# ---------------------------------------------------------------
# One-time admin bootstrap (npm run create-admin)
# ---------------------------------------------------------------
# Uncomment only while creating the first admin, then remove both
# lines again. The password must be at least 12 characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# ---------------------------------------------------------------
# Demo data (npm run seed:large)
# ---------------------------------------------------------------
# Shared password for seeded @seed.b2b.local accounts. If unset, a
# random one is generated and printed once.
# SEED_USER_PASSWORD=

# ---------------------------------------------------------------
# Help assistant (optional)
# ---------------------------------------------------------------
# Without a key the helper answers from its built-in help guide.
# With an Anthropic API key, Claude writes the answers from the
# same guide. Each question costs a little; the daily limit caps
# how many questions per day can use Claude (the rest use search).
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_DAILY_LIMIT=300

# ---------------------------------------------------------------
# Public live demo (optional, never on real data)
# ---------------------------------------------------------------
# Shows one-click demo accounts on the login page and turns off
# password and account changes. DEMO_PASSWORD is shown publicly.
# Reset the data nightly with deploy/demo-reset.sh (docs/live-demo.md).
# DEMO_MODE=true
# DEMO_PASSWORD=
# DEMO_RESET_TIME=03:00 UTC

# ---------------------------------------------------------------
# Emails to clients (optional)
# ---------------------------------------------------------------
# Quotes, invoices and payment reminders. Any SMTP server works
# (your mail provider, Brevo, Mailgun, Gmail with an app password).
# Without SMTP_HOST nothing is sent: emails are saved to the in-app
# outbox (Emails page). Demo mode never sends real email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="B2B Platform SARL" <billing@yourcompany.ma>
# Payment reminders: how many days before the due date (once per invoice).
# EMAIL_REMINDERS=true
# EMAIL_REMINDER_DAYS=3
# Links in emails (to the client portal). Defaults to the first CORS_ORIGIN.
# PUBLIC_URL=https://app.yourcompany.ma
